{
  "expo": {
    "name": "Manning-Strickler",
    "slug": "manning-strickler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f4e79"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lano2889.manningstrickler"
    },
    "android": {
      "package": "com.lano2889.manningstrickler",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f4e79"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
