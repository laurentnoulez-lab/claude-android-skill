{
  "name": "gabarit-tranchees-v2",
  "productName": "Gabarit Tranchées 2.0",
  "version": "2.0.0",
  "description": "Calcul des largeurs, volumes et répartition des tranchées par impétrant — génération Excel et Word",
  "main": "main.js",
  "author": "Gabarit Tranchées",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.tranchees.impetrants.v2",
    "productName": "Gabarit Tranchées 2.0",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GabaritTranchees2-portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gabarit Tranchées 2.0",
      "artifactName": "GabaritTranchees2-Setup-${version}.${ext}",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "uninstallDisplayName": "Gabarit Tranchées 2.0"
    }
  }
}
