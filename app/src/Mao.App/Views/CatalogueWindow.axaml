<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mao.App.ViewModels"
        xmlns:entities="using:Mao.Domain.Entities"
        x:Class="Mao.App.Views.CatalogueWindow"
        x:DataType="vm:CatalogueViewModel"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Catalogue normalisé — sélection d'un poste">

  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" Text="Rechercher un poste standardisé (code, intitulé ou description)"
               FontWeight="Bold" Margin="0,0,0,6"/>
    <TextBox DockPanel.Dock="Top" Watermark="Ex. : revêtement, D1000, déblais…"
             Text="{Binding Terme}" Margin="0,0,0,8"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
      <Button Content="Annuler" Click="OnAnnuler"/>
      <Button Content="Insérer le poste" Classes="accent" Click="OnInserer"
              IsEnabled="{Binding Selection, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Resultats}"
              SelectedItem="{Binding Selection}"
              AutoGenerateColumns="False" IsReadOnly="True"
              GridLinesVisibility="All" HeadersVisibility="Column"
              DoubleTapped="OnInserer">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Width="90" Binding="{Binding Code}"/>
        <DataGridTextColumn Header="Intitulé" Width="220" Binding="{Binding Intitule}"/>
        <DataGridTextColumn Header="Unité" Width="70" Binding="{Binding Unite}"/>
        <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
