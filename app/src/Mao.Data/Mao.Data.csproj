<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catalogue des Postes Normalisés Qualiroutes (QR21, repris de MAO.db), gzippé -->
    <EmbeddedResource Include="Resources\catalogue_qr.json.gz" />
    <!-- Données utilisateur reprises de MAO.db (métrés + TVA), gzippées -->
    <EmbeddedResource Include="Resources\donnees_mao.json.gz" />
    <!-- Référentiel repris de MAO.db : déchets, indices, formules de référence -->
    <EmbeddedResource Include="Resources\referentiel.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mao.Domain\Mao.Domain.csproj" />
  </ItemGroup>

</Project>
